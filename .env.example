# Copy to .env.local for local development. All variables are optional.

# Destination of the "start a conversation" call to action on /partner.
# Accepted values: an https:// or http:// URL (scheduling page, form), or a
# mailto: address. Validated at build time; an invalid value fails the build.
# When unset, /partner shows no contact button and no source link.
# The page is static, so changing this value requires a rebuild/redeploy.
NEXT_PUBLIC_CONTACT_URL=

# Base URL for canonical and Open Graph URLs. On Vercel this is derived from
# VERCEL_PROJECT_PRODUCTION_URL automatically; set it only when deploying
# elsewhere, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=
